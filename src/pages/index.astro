---
// Speaking Clock - Main Page
import '../styles/global.css';
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Speaking Clock - 會說話的時鐘</title>
    <meta name="description" content="一個精美的語音報時工具，採用 Clean Architecture 設計" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div id="app">
      <header>
        <h1>⏰ Speaking Clock</h1>
        <p class="subtitle">會說話的時鐘</p>
      </header>

      <main>
        <section class="clock-display">
          <div id="clock" class="clock">00:00:00</div>
          <div id="period" class="period">AM</div>
        </section>

        <section class="controls">
          <button id="speak-btn" class="btn btn-primary" aria-label="播報時間">
            🔊 播報時間
          </button>
          <button id="settings-btn" class="btn btn-secondary" aria-label="設定">
            ⚙️ 設定
          </button>
        </section>

        <section id="settings-panel" class="settings-panel hidden">
          <h2>設定</h2>
          <div class="setting-group">
            <label for="language">語言</label>
            <select id="language" name="language">
              <option value="zh-TW">繁體中文</option>
              <option value="en-US">English</option>
            </select>
          </div>
          <div class="setting-group">
            <label for="voice-rate">語速: <span id="voice-rate-value">1.0</span></label>
            <input type="range" id="voice-rate" min="0.5" max="2" step="0.1" value="1" />
          </div>
          <div class="setting-group">
            <label for="voice-volume">音量: <span id="voice-volume-value">1.0</span></label>
            <input type="range" id="voice-volume" min="0" max="1" step="0.1" value="1" />
          </div>
          <div class="setting-group">
            <label for="announce-interval">報時間隔（分鐘）</label>
            <input type="number" id="announce-interval" min="1" max="60" value="30" />
          </div>
          <div class="setting-group">
            <label class="checkbox-label">
              <input type="checkbox" id="enabled" checked />
              啟用語音報時
            </label>
          </div>
          <button id="save-settings" class="btn btn-primary">儲存設定</button>
        </section>
      </main>

      <footer>
        <p>採用 Clean Architecture + TDD 開發 | Powered by Astro</p>
      </footer>
    </div>

    <script type="module" src="../scripts/main.ts"></script>
  </body>
</html>
