---
// Speaking Clock - Main Page
import '../styles/global.css';
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Speaking Clock - 會說話的時鐘</title>
    <meta name="description" content="一個精美的語音報時工具，採用 Clean Architecture 設計" />
    <link rel="icon" type="image/svg+xml" href="/speaking-clock-20260123/favicon.svg" />
  </head>
  <body>
    <div id="app">
      <header>
        <div class="logo-container">
          <svg class="logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12,6 12,12 16,14"/>
          </svg>
          <h1>Speaking Clock</h1>
        </div>
        <p class="subtitle">會說話的時鐘</p>
      </header>

      <main>
        <section class="clock-display">
          <div id="clock" class="clock">00:00:00</div>
          <div id="period" class="period">AM</div>
        </section>

        <!-- Motivational Quote -->
        <section class="quote-section">
          <p id="quote" class="quote">每一天都是新的開始</p>
        </section>

        <section class="controls">
          <button id="speak-btn" class="btn btn-primary" aria-label="播報時間">
            <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="11,5 6,9 2,9 2,15 6,15 11,19 11,5"/>
              <path d="M15.54,8.46a5,5,0,0,1,0,7.07"/>
              <path d="M19.07,4.93a10,10,0,0,1,0,14.14"/>
            </svg>
            播報時間
          </button>
          <button id="settings-btn" class="btn btn-secondary" aria-label="設定">
            <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"/>
              <path d="M19.4,15a1.65,1.65,0,0,0,.33,1.82l.06.06a2,2,0,0,1,0,2.83,2,2,0,0,1-2.83,0l-.06-.06a1.65,1.65,0,0,0-1.82-.33,1.65,1.65,0,0,0-1,1.51V21a2,2,0,0,1-4,0v-.09A1.65,1.65,0,0,0,9,19.4a1.65,1.65,0,0,0-1.82.33l-.06.06a2,2,0,0,1-2.83,0,2,2,0,0,1,0-2.83l.06-.06a1.65,1.65,0,0,0,.33-1.82,1.65,1.65,0,0,0-1.51-1H3a2,2,0,0,1,0-4h.09A1.65,1.65,0,0,0,4.6,9a1.65,1.65,0,0,0-.33-1.82l-.06-.06a2,2,0,0,1,0-2.83,2,2,0,0,1,2.83,0l.06.06a1.65,1.65,0,0,0,1.82.33H9a1.65,1.65,0,0,0,1-1.51V3a2,2,0,0,1,4,0v.09a1.65,1.65,0,0,0,1,1.51,1.65,1.65,0,0,0,1.82-.33l.06-.06a2,2,0,0,1,2.83,0,2,2,0,0,1,0,2.83l-.06.06a1.65,1.65,0,0,0-.33,1.82V9a1.65,1.65,0,0,0,1.51,1H21a2,2,0,0,1,0,4h-.09a1.65,1.65,0,0,0-1.51,1Z"/>
            </svg>
            設定
          </button>
        </section>

        <div id="auto-announce-status" class="auto-announce-status">
          <span class="indicator"></span>
          <span id="status-text">自動報時已關閉</span>
        </div>

        <!-- Todo Reminders Section -->
        <section class="todo-section">
          <div class="todo-header">
            <h2>
              <svg class="todo-header-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18,8A6,6,0,0,0,6,8c0,7-3,9-3,9H21s-3-2-3-9"/>
                <path d="M13.73,21a2,2,0,0,1-3.46,0"/>
              </svg>
              待辦提醒
            </h2>
            <p class="todo-subtitle">設定時間，到點會語音提醒直到關閉</p>
          </div>

          <div class="todo-input-group">
            <input
              type="time"
              id="todo-time"
              class="todo-time-input"
            />
            <input
              type="text"
              id="todo-input"
              class="todo-input"
              placeholder="輸入提醒內容..."
              maxlength="100"
            />
            <button id="add-todo-btn" class="btn-add-todo" aria-label="新增提醒">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
              </svg>
            </button>
          </div>

          <ul id="todo-list" class="todo-list">
            <!-- Reminder items will be rendered here -->
          </ul>

          <!-- Active reminder alert -->
          <div id="reminder-alert" class="reminder-alert hidden">
            <div class="reminder-alert-content">
              <svg class="reminder-alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18,8A6,6,0,0,0,6,8c0,7-3,9-3,9H21s-3-2-3-9"/>
                <path d="M13.73,21a2,2,0,0,1-3.46,0"/>
              </svg>
              <span id="reminder-alert-text">提醒內容</span>
            </div>
            <button id="dismiss-reminder-btn" class="btn btn-primary">關閉提醒</button>
          </div>
        </section>

        <section id="settings-panel" class="settings-panel hidden">
          <h2>設定</h2>
          <div class="setting-group">
            <label for="language">語言</label>
            <select id="language" name="language">
              <option value="zh-TW">繁體中文</option>
              <option value="en-US">English</option>
            </select>
          </div>
          <div class="setting-group">
            <label for="voice-rate">語速: <span id="voice-rate-value">1.0</span></label>
            <input type="range" id="voice-rate" min="0.5" max="2" step="0.1" value="1" />
          </div>
          <div class="setting-group">
            <label for="voice-volume">音量: <span id="voice-volume-value">1.0</span></label>
            <input type="range" id="voice-volume" min="0" max="1" step="0.1" value="1" />
          </div>
          <div class="setting-group">
            <label for="announce-interval">報時間隔（分鐘）</label>
            <input type="number" id="announce-interval" min="1" max="60" value="30" />
          </div>
          <div class="setting-group">
            <label class="checkbox-label">
              <input type="checkbox" id="enabled" checked />
              啟用語音報時
            </label>
          </div>
          <div class="setting-group">
            <label class="checkbox-label">
              <input type="checkbox" id="healing-enabled" />
              荷歐波諾波諾語錄（每分鐘朗讀）
            </label>
            <p class="setting-hint">開啟後每分鐘隨機朗讀一句療癒語錄</p>
          </div>
          <button id="save-settings" class="btn btn-primary">儲存設定</button>
        </section>
      </main>

      <footer>
        <p>採用 Clean Architecture + TDD 開發 | Powered by Astro</p>
        <p class="version">v20260123.4</p>
      </footer>
    </div>

    <script>
