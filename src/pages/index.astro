---
// Speaking Clock - Main Page
import '../styles/global.css';
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Speaking Clock - 會說話的時鐘</title>
    <meta name="description" content="一個精美的語音報時工具，採用 Clean Architecture 設計" />
    <link rel="icon" type="image/svg+xml" href="/speaking-clock-20260123/favicon.svg" />
  </head>
  <body>
    <div id="app">
      <header>
        <h1>⏰ Speaking Clock</h1>
        <p class="subtitle">會說話的時鐘</p>
      </header>

      <main>
        <section class="clock-display">
          <div id="clock" class="clock">00:00:00</div>
          <div id="period" class="period">AM</div>
        </section>

        <section class="controls">
          <button id="speak-btn" class="btn btn-primary" aria-label="播報時間">
            🔊 播報時間
          </button>
          <button id="settings-btn" class="btn btn-secondary" aria-label="設定">
            ⚙️ 設定
          </button>
        </section>

        <div id="auto-announce-status" class="auto-announce-status">
          <span class="indicator"></span>
          <span id="status-text">自動報時已關閉</span>
        </div>

        <!-- Todo Reminders Section -->
        <section class="todo-section">
          <div class="todo-header">
            <h2>⏰ 待辦提醒</h2>
            <p class="todo-subtitle">設定時間，到點會語音提醒直到關閉</p>
          </div>

          <div class="todo-input-group">
            <input
              type="time"
              id="todo-time"
              class="todo-time-input"
            />
            <input
              type="text"
              id="todo-input"
              class="todo-input"
              placeholder="輸入提醒內容..."
              maxlength="100"
            />
            <button id="add-todo-btn" class="btn-add-todo" aria-label="新增提醒">
              <span>+</span>
            </button>
          </div>

          <ul id="todo-list" class="todo-list">
            <!-- Reminder items will be rendered here -->
          </ul>

          <!-- Active reminder alert -->
          <div id="reminder-alert" class="reminder-alert hidden">
            <div class="reminder-alert-content">
              <span class="reminder-alert-icon">🔔</span>
              <span id="reminder-alert-text">提醒內容</span>
            </div>
            <button id="dismiss-reminder-btn" class="btn btn-primary">關閉提醒</button>
          </div>
        </section>

        <section id="settings-panel" class="settings-panel hidden">
          <h2>設定</h2>
          <div class="setting-group">
            <label for="language">語言</label>
            <select id="language" name="language">
              <option value="zh-TW">繁體中文</option>
              <option value="en-US">English</option>
            </select>
          </div>
          <div class="setting-group">
            <label for="voice-rate">語速: <span id="voice-rate-value">1.0</span></label>
            <input type="range" id="voice-rate" min="0.5" max="2" step="0.1" value="1" />
          </div>
          <div class="setting-group">
            <label for="voice-volume">音量: <span id="voice-volume-value">1.0</span></label>
            <input type="range" id="voice-volume" min="0" max="1" step="0.1" value="1" />
          </div>
          <div class="setting-group">
            <label for="announce-interval">報時間隔（分鐘）</label>
            <input type="number" id="announce-interval" min="1" max="60" value="30" />
          </div>
          <div class="setting-group">
            <label class="checkbox-label">
              <input type="checkbox" id="enabled" checked />
              啟用語音報時
            </label>
          </div>
          <button id="save-settings" class="btn btn-primary">儲存設定</button>
        </section>
      </main>

      <footer>
        <p>採用 Clean Architecture + TDD 開發 | Powered by Astro</p>
        <p class="version">v20260123.3</p>
      </footer>
    </div>

    <script>
      // ============================================================
      // DOMAIN LAYER - Entities (型別定義，JSDoc 形式)
      // ============================================================

      /**
       * @typedef {Object} ClockSettings
       * @property {string} language - 語言代碼 (如 'zh-TW', 'en-US')
       * @property {number} voiceRate - 語速 (0.1-10)
       * @property {number} voiceVolume - 音量 (0-1)
       * @property {number} announceInterval - 報時間隔（分鐘）
       * @property {boolean} isEnabled - 是否啟用
       */

      // ============================================================
      // DOMAIN LAYER - Use Cases
      // ============================================================

      class SpeakTimeUseCase {
        constructor(speechSynthesizer, timeRepository) {
          this.speechSynthesizer = speechSynthesizer;
          this.timeRepository = timeRepository;
        }

        async execute(settings) {
          if (!settings.isEnabled) {
            return;
          }

          const currentTime = this.timeRepository.getCurrentTime();
          const timeText = this.timeRepository.formatTime(currentTime, '12h');
          const speechText = this.buildSpeechText(timeText, settings.language);

          await this.speechSynthesizer.speak(
            speechText,
            settings.language,
            settings.voiceRate,
            settings.voiceVolume
          );
        }

        buildSpeechText(time, language) {
          if (language.startsWith('zh')) {
            return `現在時間是 ${time}`;
          }
          return `The time is ${time}`;
        }
      }

      // ============================================================
      // INFRASTRUCTURE LAYER - Adapters
      // ============================================================

      class BrowserSpeechSynthesizer {
        constructor() {
          this.synth = window.speechSynthesis;
        }

        async speak(text, language, rate, volume) {
          return new Promise((resolve, reject) => {
            this.synth.cancel();

            const utterance = new SpeechSynthesisUtterance(text);
            utterance.lang = language;
            utterance.rate = rate;
            utterance.volume = volume;

            // 嘗試選擇台灣中文女生語音
            const voices = this.synth.getVoices();
            const zhTWVoices = voices.filter(v => v.lang === 'zh-TW' || v.lang === 'zh_TW');

            // 優先選擇女聲（通常名稱包含 "Female" 或 "女"）
            const femaleVoice = zhTWVoices.find(v =>
              v.name.includes('Female') ||
              v.name.includes('女') ||
              v.name.includes('Meijia') ||
              v.name.includes('Ting-Ting')
            );

            if (femaleVoice) {
              utterance.voice = femaleVoice;
            } else if (zhTWVoices.length > 0) {
              utterance.voice = zhTWVoices[0];
            }

            utterance.onend = () => resolve();
            utterance.onerror = (event) => reject(new Error(`Speech error: ${event.error}`));

            this.synth.speak(utterance);
          });
        }

        getAvailableVoices() {
          return this.synth.getVoices().map((voice) => ({
            name: voice.name,
            lang: voice.lang,
          }));
        }
      }

      class SystemTimeRepository {
        getCurrentTime() {
          return new Date();
        }

        formatTime(date, format) {
          const hours = date.getHours();
          const minutes = date.getMinutes();
          const seconds = date.getSeconds();

          if (format === '24h') {
            return `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
          }

          const period = hours >= 12 ? 'PM' : 'AM';
          const displayHours = hours % 12 || 12;

          return `${String(displayHours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')} ${period}`;
        }
      }

      const DEFAULT_SETTINGS = {
        language: 'zh-TW',
        voiceRate: 1,
        voiceVolume: 1,
        announceInterval: 30,
        isEnabled: true,
      };

      // ============================================================
      // DOMAIN LAYER - Reminder Entity & Repository
      // ============================================================

      /**
       * @typedef {Object} Reminder
       * @property {string} id - 唯一識別碼
       * @property {string} time - 提醒時間 (HH:MM)
       * @property {string} text - 提醒內容
       * @property {boolean} isRinging - 是否正在響鈴
       * @property {boolean} completed - 是否已完成
       */

      class ReminderRepository {
        constructor() {
          this.STORAGE_KEY = 'speaking-clock-reminders';
        }

        getReminders() {
          try {
            const stored = localStorage.getItem(this.STORAGE_KEY);
            if (stored) {
              return JSON.parse(stored);
            }
          } catch (error) {
            console.error('Failed to load reminders:', error);
          }
          return [];
        }

        saveReminders(reminders) {
          try {
            localStorage.setItem(this.STORAGE_KEY, JSON.stringify(reminders));
          } catch (error) {
            console.error('Failed to save reminders:', error);
          }
        }

        addReminder(time, text) {
          const reminders = this.getReminders();
          const newReminder = {
            id: Date.now().toString(),
            time,
            text,
            isRinging: false,
            completed: false,
          };
          reminders.push(newReminder);
          this.saveReminders(reminders);
          return newReminder;
        }

        updateReminder(id, updates) {
          const reminders = this.getReminders();
          const index = reminders.findIndex(r => r.id === id);
          if (index !== -1) {
            reminders[index] = { ...reminders[index], ...updates };
            this.saveReminders(reminders);
            return reminders[index];
          }
          return null;
        }

        deleteReminder(id) {
          const reminders = this.getReminders();
          const filtered = reminders.filter(r => r.id !== id);
          this.saveReminders(filtered);
        }

        dismissReminder(id) {
          return this.updateReminder(id, { isRinging: false, completed: true });
        }

        setRinging(id, isRinging) {
          return this.updateReminder(id, { isRinging });
        }
      }

      class LocalStorageSettingsRepository {
        constructor() {
          this.STORAGE_KEY = 'speaking-clock-settings';
        }

        async getSettings() {
          if (typeof window === 'undefined') {
            return DEFAULT_SETTINGS;
          }

          try {
            const stored = localStorage.getItem(this.STORAGE_KEY);
            if (stored) {
              return { ...DEFAULT_SETTINGS, ...JSON.parse(stored) };
            }
          } catch (error) {
            console.error('Failed to load settings:', error);
          }

          return DEFAULT_SETTINGS;
        }

        async saveSettings(settings) {
          if (typeof window === 'undefined') {
            return;
          }

          try {
            localStorage.setItem(this.STORAGE_KEY, JSON.stringify(settings));
          } catch (error) {
            console.error('Failed to save settings:', error);
          }
        }
      }

      // ============================================================
      // PRESENTATION LAYER - UI Logic
      // ============================================================

      class SpeakingClockApp {
        constructor() {
          // Initialize dependencies (Dependency Injection)
          this.settingsRepo = new LocalStorageSettingsRepository();
          this.timeRepo = new SystemTimeRepository();
          this.speechSynth = new BrowserSpeechSynthesizer();
          this.speakTimeUseCase = new SpeakTimeUseCase(this.speechSynth, this.timeRepo);
          this.reminderRepo = new ReminderRepository();

          // Get DOM elements
          this.clockEl = document.getElementById('clock');
          this.periodEl = document.getElementById('period');
          this.speakBtn = document.getElementById('speak-btn');
          this.settingsBtn = document.getElementById('settings-btn');
          this.settingsPanel = document.getElementById('settings-panel');
          this.saveSettingsBtn = document.getElementById('save-settings');

          this.languageSelect = document.getElementById('language');
          this.voiceRateInput = document.getElementById('voice-rate');
          this.voiceRateValue = document.getElementById('voice-rate-value');
          this.voiceVolumeInput = document.getElementById('voice-volume');
          this.voiceVolumeValue = document.getElementById('voice-volume-value');
          this.announceIntervalInput = document.getElementById('announce-interval');
          this.enabledCheckbox = document.getElementById('enabled');

          this.timer = null;
          this.autoAnnounceTimer = null;
          this.reminderCheckTimer = null;
          this.activeReminderTimer = null;

          // Auto-announce status elements
          this.statusEl = document.getElementById('auto-announce-status');
          this.statusTextEl = document.getElementById('status-text');

          // Reminder elements
          this.todoTimeInput = document.getElementById('todo-time');
          this.todoInput = document.getElementById('todo-input');
          this.addTodoBtn = document.getElementById('add-todo-btn');
          this.todoList = document.getElementById('todo-list');
          this.reminderAlert = document.getElementById('reminder-alert');
          this.reminderAlertText = document.getElementById('reminder-alert-text');
          this.dismissReminderBtn = document.getElementById('dismiss-reminder-btn');

          this.currentRingingReminder = null;
        }

        async init() {
          // Load and apply settings
          const settings = await this.settingsRepo.getSettings();
          this.applySettings(settings);

          // Start clock
          this.startClock();

          // Start auto-announce if enabled
          this.startAutoAnnounce(settings);

          // Setup event listeners
          this.setupEventListeners();
          this.setupSettingsListeners();

          // Initialize reminders
          this.renderReminders();
          this.setupReminderListeners();
          this.startReminderChecker();
        }

        startAutoAnnounce(settings) {
          // Clear existing timer
          if (this.autoAnnounceTimer) {
            clearInterval(this.autoAnnounceTimer);
            this.autoAnnounceTimer = null;
          }

          if (!settings.isEnabled) {
            this.updateAutoAnnounceStatus(false, 0);
            return;
          }

          const intervalMs = settings.announceInterval * 60 * 1000;

          this.autoAnnounceTimer = setInterval(async () => {
            const currentSettings = await this.settingsRepo.getSettings();
            if (currentSettings.isEnabled) {
              await this.speakTimeUseCase.execute(currentSettings);
            }
          }, intervalMs);

          this.updateAutoAnnounceStatus(true, settings.announceInterval);
        }

        updateAutoAnnounceStatus(active, intervalMinutes) {
          if (active) {
            this.statusEl.classList.add('active');
            this.statusTextEl.textContent = `自動報時：每 ${intervalMinutes} 分鐘`;
          } else {
            this.statusEl.classList.remove('active');
            this.statusTextEl.textContent = '自動報時已關閉';
          }
        }

        startClock() {
          const updateClock = () => {
            const now = this.timeRepo.getCurrentTime();
            const timeStr = this.timeRepo.formatTime(now, '12h');
            const [time, period] = timeStr.split(' ');

            this.clockEl.textContent = time;
            this.periodEl.textContent = period;
          };

          updateClock();
          this.timer = setInterval(updateClock, 1000);
        }

        setupEventListeners() {
          this.speakBtn.addEventListener('click', async () => {
            const settings = await this.settingsRepo.getSettings();
            await this.speakTimeUseCase.execute(settings);
          });

          this.settingsBtn.addEventListener('click', () => {
            this.settingsPanel.classList.toggle('hidden');
          });

          this.saveSettingsBtn.addEventListener('click', async () => {
            const settings = this.getSettingsFromUI();
            await this.settingsRepo.saveSettings(settings);
            this.settingsPanel.classList.add('hidden');

            // Restart auto-announce with new settings
            this.startAutoAnnounce(settings);

            // Show feedback
            this.saveSettingsBtn.textContent = '已儲存！';
            setTimeout(() => {
              this.saveSettingsBtn.textContent = '儲存設定';
            }, 1500);
          });
        }

        setupSettingsListeners() {
          this.voiceRateInput.addEventListener('input', () => {
            this.voiceRateValue.textContent = this.voiceRateInput.value;
          });

          this.voiceVolumeInput.addEventListener('input', () => {
            this.voiceVolumeValue.textContent = this.voiceVolumeInput.value;
          });
        }

        applySettings(settings) {
          this.languageSelect.value = settings.language;
          this.voiceRateInput.value = settings.voiceRate.toString();
          this.voiceRateValue.textContent = settings.voiceRate.toString();
          this.voiceVolumeInput.value = settings.voiceVolume.toString();
          this.voiceVolumeValue.textContent = settings.voiceVolume.toString();
          this.announceIntervalInput.value = settings.announceInterval.toString();
          this.enabledCheckbox.checked = settings.isEnabled;
        }

        getSettingsFromUI() {
          return {
            language: this.languageSelect.value,
            voiceRate: parseFloat(this.voiceRateInput.value),
            voiceVolume: parseFloat(this.voiceVolumeInput.value),
            announceInterval: parseInt(this.announceIntervalInput.value),
            isEnabled: this.enabledCheckbox.checked,
          };
        }

        // ============================================================
        // REMINDER METHODS
        // ============================================================

        setupReminderListeners() {
          // Add reminder
          this.addTodoBtn.addEventListener('click', () => this.addReminder());
          this.todoInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') this.addReminder();
          });

          // Dismiss reminder
          this.dismissReminderBtn.addEventListener('click', () => this.dismissActiveReminder());

          // Set default time to next hour
          const now = new Date();
          const nextHour = new Date(now.getTime() + 60 * 60 * 1000);
          this.todoTimeInput.value = `${String(nextHour.getHours()).padStart(2, '0')}:00`;
        }

        addReminder() {
          const time = this.todoTimeInput.value;
          const text = this.todoInput.value.trim();

          if (!time || !text) {
            this.todoInput.focus();
            return;
          }

          this.reminderRepo.addReminder(time, text);
          this.todoInput.value = '';
          this.renderReminders();
        }

        renderReminders() {
          const reminders = this.reminderRepo.getReminders();

          // Clear existing content
          while (this.todoList.firstChild) {
            this.todoList.removeChild(this.todoList.firstChild);
          }

          if (reminders.length === 0) {
            const emptyLi = document.createElement('li');
            emptyLi.className = 'todo-empty';
            emptyLi.textContent = '尚無提醒，新增一個吧！';
            this.todoList.appendChild(emptyLi);
            return;
          }

          // Sort by time, incomplete first
          const sorted = [...reminders].sort((a, b) => {
            if (a.completed !== b.completed) return a.completed ? 1 : -1;
            return a.time.localeCompare(b.time);
          });

          sorted.forEach(reminder => {
            const li = document.createElement('li');
            li.className = `todo-item ${reminder.completed ? 'completed' : ''} ${reminder.isRinging ? 'ringing' : ''}`;
            li.dataset.id = reminder.id;

            // Time
            const timeSpan = document.createElement('span');
            timeSpan.className = 'todo-time';
            timeSpan.textContent = reminder.time;
            li.appendChild(timeSpan);

            // Checkbox
            const checkbox = document.createElement('input');
            checkbox.type = 'checkbox';
            checkbox.className = 'todo-checkbox';
            checkbox.checked = reminder.completed;
            checkbox.addEventListener('change', () => {
              this.reminderRepo.updateReminder(reminder.id, {
                completed: checkbox.checked,
                isRinging: false
              });
              if (this.currentRingingReminder?.id === reminder.id) {
                this.stopActiveReminder();
              }
              this.renderReminders();
            });
            li.appendChild(checkbox);

            // Text
            const textSpan = document.createElement('span');
            textSpan.className = 'todo-text';
            textSpan.textContent = reminder.text;
            li.appendChild(textSpan);

            // Ringing badge
            if (reminder.isRinging) {
              const badge = document.createElement('span');
              badge.className = 'todo-badge';
              badge.textContent = '🔔 響鈴中';
              li.appendChild(badge);
            }

            // Actions
            const actions = document.createElement('div');
            actions.className = 'todo-actions';

            const editBtn = document.createElement('button');
            editBtn.className = 'todo-action-btn edit';
            editBtn.setAttribute('aria-label', '編輯');
            editBtn.textContent = '✏️';
            editBtn.addEventListener('click', () => this.editReminder(reminder.id));
            actions.appendChild(editBtn);

            const deleteBtn = document.createElement('button');
            deleteBtn.className = 'todo-action-btn delete';
            deleteBtn.setAttribute('aria-label', '刪除');
            deleteBtn.textContent = '🗑️';
            deleteBtn.addEventListener('click', () => {
              if (this.currentRingingReminder?.id === reminder.id) {
                this.stopActiveReminder();
              }
              this.reminderRepo.deleteReminder(reminder.id);
              this.renderReminders();
            });
            actions.appendChild(deleteBtn);

            li.appendChild(actions);
            this.todoList.appendChild(li);
          });
        }

        editReminder(id) {
          const reminders = this.reminderRepo.getReminders();
          const reminder = reminders.find(r => r.id === id);
          if (!reminder) return;

          const newText = prompt('修改提醒內容：', reminder.text);
          if (newText !== null && newText.trim()) {
            this.reminderRepo.updateReminder(id, { text: newText.trim() });
            this.renderReminders();
          }
        }

        startReminderChecker() {
          // Check reminders every 30 seconds
          this.reminderCheckTimer = setInterval(() => {
            this.checkReminders();
          }, 30000);

          // Also check immediately
          this.checkReminders();
        }

        checkReminders() {
          const now = new Date();
          const currentTime = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;

          const reminders = this.reminderRepo.getReminders();

          for (const reminder of reminders) {
            if (reminder.completed) continue;

            // Check if time matches and not already ringing
            if (reminder.time === currentTime && !reminder.isRinging) {
              this.triggerReminder(reminder);
              break; // Only trigger one at a time
            }
          }
        }

        async triggerReminder(reminder) {
          // Mark as ringing
          this.reminderRepo.setRinging(reminder.id, true);
          this.currentRingingReminder = reminder;
          this.renderReminders();

          // Show alert
          this.reminderAlert.classList.remove('hidden');
          this.reminderAlertText.textContent = reminder.text;

          // Speak the reminder
          await this.speakReminder(reminder);

          // Keep reminding every minute until dismissed
          this.activeReminderTimer = setInterval(async () => {
            if (this.currentRingingReminder) {
              await this.speakReminder(this.currentRingingReminder);
            }
          }, 60000);
        }

        async speakReminder(reminder) {
          const settings = await this.settingsRepo.getSettings();
          const text = settings.language.startsWith('zh')
            ? `提醒：${reminder.text}`
            : `Reminder: ${reminder.text}`;

          await this.speechSynth.speak(
            text,
            settings.language,
            settings.voiceRate,
            settings.voiceVolume
          );
        }

        dismissActiveReminder() {
          if (this.currentRingingReminder) {
            this.reminderRepo.dismissReminder(this.currentRingingReminder.id);
            this.stopActiveReminder();
            this.renderReminders();
          }
        }

        stopActiveReminder() {
          if (this.activeReminderTimer) {
            clearInterval(this.activeReminderTimer);
            this.activeReminderTimer = null;
          }
          this.currentRingingReminder = null;
          this.reminderAlert.classList.add('hidden');
        }
      }

      // Initialize app when DOM is ready
      document.addEventListener('DOMContentLoaded', () => {
        const app = new SpeakingClockApp();
        app.init();
      });
    </script>
  </body>
</html>
